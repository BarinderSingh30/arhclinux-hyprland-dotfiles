#!/usr/bin/env bash
#
# wifi-menu -- wifi network picker and control, from rofi.
#
#   wifi-menu    # scan, connect, disconnect, forget a network, toggle radio
#
# Mirrors power-menu's shape: rofi -dmenu -format i so labels (Nerd Font
# glyphs + spaces) can never be mismatched on select -- an index cannot be
# mangled by whitespace, a label can. notify-send reports anything the popup
# itself can't, since rofi has already closed by the time a connect attempt
# succeeds or fails.
#
# The wifi device is resolved at runtime rather than hardcoded: interface
# names like wlp0s20f3 are a product of the current hardware/driver and are
# not guaranteed stable.
#
# Known limitation: hidden SSIDs are skipped (nmcli reports them as an empty
# ssid field, and there is no way to offer "connect to a hidden network by
# name" from a plain list without a second prompt every time the menu opens).
# "Forget" assumes NetworkManager named the saved profile after the SSID,
# which is what `nmcli device wifi connect` does by default.

set -euo pipefail

die() { printf '\033[31mwifi-menu:\033[0m %s\n' "$*" >&2; exit 1; }
notify() { command -v notify-send >/dev/null && notify-send -a wifi-menu "$@" || printf '%s\n' "$*"; }

command -v nmcli >/dev/null || die "nmcli not found"
command -v rofi  >/dev/null || die "rofi not found"

dev=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}')
[[ -n $dev ]] || die "no wifi device found"

pick() {
    rofi -dmenu -p "$1" -no-show-icons -no-custom -format i -l "$2" \
        -theme-str "window { width: 30em; } listview { lines: $2; }"
}

pick_password() {
    rofi -dmenu -p "password for $1" -password -no-show-icons \
        -theme-str 'window { width: 30em; }'
}

signal_icon() {
    local s=$1
    if   (( s >= 70 )); then printf '󰤨'
    elif (( s >= 45 )); then printf '󰤥'
    elif (( s >= 20 )); then printf '󰤢'
    else                     printf '󰤟'
    fi
}

has_profile() {
    nmcli -t -f NAME connection show | grep -qxF "$1"
}

connect() {
    local ssid=$1 security=$2 pw out

    if has_profile "$ssid"; then
        if out=$(nmcli connection up id "$ssid" 2>&1); then
            notify "Connected to $ssid"
        else
            notify "Failed to connect to $ssid" "$out"
        fi
        return
    fi

    if [[ -n $security && $security != "--" ]]; then
        pw=$(pick_password "$ssid") || exit 0
        [[ -n $pw ]] || { notify "No password entered"; exit 0; }
        out=$(nmcli device wifi connect "$ssid" password "$pw" ifname "$dev" 2>&1) && ok=1 || ok=0
    else
        out=$(nmcli device wifi connect "$ssid" ifname "$dev" 2>&1) && ok=1 || ok=0
    fi

    if [[ $ok == 1 ]]; then
        notify "Connected to $ssid"
    else
        notify "Failed to connect to $ssid" "$out"
    fi
}

dispatch() {
    local action=$1 kind rest ssid security

    kind=${action%%:*}
    rest=${action#*:}

    case $kind in
        radio-off)
            nmcli radio wifi off
            notify "Wifi disabled"
            ;;
        disconnect)
            nmcli connection down id "$rest" >/dev/null
            notify "Disconnected from $rest"
            ;;
        forget)
            nmcli connection delete id "$rest" >/dev/null
            notify "Forgot $rest"
            ;;
        connect)
            ssid=${rest%%:*}
            security=${rest#*:}
            connect "$ssid" "$security"
            ;;
    esac
}

main() {
    local radio active_ssid idx action

    radio=$(nmcli radio wifi)

    if [[ $radio == disabled ]]; then
        idx=$(printf '%s\n' "󰤭  Turn wifi on" | pick "wifi" 1) || exit 0
        [[ $idx == 0 ]] && { nmcli radio wifi on; notify "Wifi enabled"; }
        exit 0
    fi

    active_ssid=$(nmcli -t -f active,ssid device wifi list ifname "$dev" --rescan no 2>/dev/null \
        | awk -F: '$1=="yes"{print $2; exit}')

    # active:ssid:signal:security, strongest signal per SSID, sorted
    # descending, hidden (empty-ssid) networks dropped.
    mapfile -t nets < <(
        nmcli -t -f active,ssid,signal,security device wifi list ifname "$dev" --rescan yes 2>/dev/null \
            | awk -F: '$2!=""' \
            | sort -t: -k3,3 -rn \
            | awk -F: '!seen[$2]++'
    )

    local rows=()
    for line in "${nets[@]}"; do
        IFS=: read -r act ssid signal security <<<"$line"
        local icon lock mark
        icon=$(signal_icon "$signal")
        lock=""
        [[ -n $security && $security != "--" ]] && lock=" 󰌾"
        mark=""
        [[ $act == yes ]] && mark=" 󰄬"
        rows+=("$icon  $ssid$lock$mark"$'\t'"connect:$ssid:$security")
    done

    rows+=("󰤭  Turn wifi off"$'\t'"radio-off:")
    if [[ -n $active_ssid ]]; then
        rows+=("󰖪  Disconnect from $active_ssid"$'\t'"disconnect:$active_ssid")
        rows+=("󰆴  Forget $active_ssid"$'\t'"forget:$active_ssid")
    fi

    local n=${#rows[@]} lines
    lines=$(( n < 12 ? n : 12 ))

    idx=$(printf '%s\n' "${rows[@]}" | cut -f1 | pick "wifi" "$lines") || exit 0
    [[ $idx =~ ^[0-9]+$ ]] || exit 0

    action=$(printf '%s\n' "${rows[@]}" | sed -n "$((idx + 1))p" | cut -f2)
    [[ -n $action ]] || die "no action for row $idx"

    dispatch "$action"
}

main
