#!/usr/bin/env bash
#
# mixer-toggle -- open pavucontrol-qt, or close it if it's already open.
#
# Used as wireplumber's on-click in waybar so the click behaves like a
# toggle instead of stacking a new window every time (waybar's on-click is
# just "run this command," it has no concept of "this app is already
# running" on its own).
#
# Closed via SIGTERM to the process rather than hyprctl's closewindow
# dispatcher: this Hyprland config is Lua (see CLAUDE.md), and
# `hl.dsp.window.close()` as used in conf/binds.lua only closes the
# currently FOCUSED window with no documented window-selector argument for
# targeting a specific class from a script. A plain volume mixer has no
# state worth a graceful-quit signal anyway.

set -euo pipefail

die()  { printf '\033[31mmixer-toggle:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[33mmixer-toggle:\033[0m %s\n' "$*" >&2; }

command -v pavucontrol-qt >/dev/null || die "pavucontrol-qt not found"

# The vibrant stylesheet is passed here rather than through qt6ct's
# `stylesheets=` key, because that key is global to every Qt6 app on qt6ct and
# this sheet is written for this window specifically -- it makes widget
# backgrounds transparent, which is right under the compositor opacity rule in
# conf/rules.lua and wrong everywhere else. `-stylesheet` is plain QApplication
# argument handling, nothing pavucontrol-qt has to support.
#
# Guarded on the file: theme-set renders it, and a Qt app given a missing
# -stylesheet path just warns and starts unstyled, but silently unstyled is
# exactly the confusing state worth naming out loud.
QSS="${XDG_CONFIG_HOME:-$HOME/.config}/theme/qt-apps.qss"

if pgrep -x pavucontrol-qt >/dev/null; then
    pkill -x pavucontrol-qt
elif [[ -f $QSS ]]; then
    pavucontrol-qt -stylesheet "$QSS" &
    disown
else
    warn "$QSS missing (run theme-set) -- opening unstyled"
    pavucontrol-qt &
    disown
fi
