[Unit]
Description=Unmute the internal speaker after WirePlumber's UCM disable sequence
# WirePlumber runs the UCM Speaker device's DisableSequence at every session
# start, which sets 'Speaker Playback Switch off' and silences the laptop
# speakers. alsa-restore runs far earlier in boot, so its saved state is
# overwritten seconds later.
#
# The card is addressed by NAME, never by index. Plugging in any USB audio
# device -- a phone, a USB headset -- claims card 0 at boot and pushes
# sof-hda-dsp to card 1. '-c0' then unmutes the wrong card and still exits 0,
# so the unit reports success while the speakers stay silent. Seen 2026-08-18
# with a realme RMX2001 connected over USB.
After=wireplumber.service
BindsTo=wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
# WirePlumber's sequence lands slightly after the unit is considered started,
# so re-assert a few times rather than racing it once.
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5 6; do \
  /usr/bin/amixer -c sofhdadsp sset Master 91%% unmute >/dev/null 2>&1; \
  /usr/bin/amixer -c sofhdadsp sset Speaker 91%% unmute >/dev/null 2>&1; \
  sleep 1; \
done'

[Install]
WantedBy=wireplumber.service
