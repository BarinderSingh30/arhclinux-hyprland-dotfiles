# GTK 3 -- @NAME@
#
# GENERATED by `theme-set @NAME@` into ~/.config/gtk-3.0/settings.ini
# Do not edit; edit ~/dotfiles/theme-src/templates/gtk3-settings.ini.in
#
# GTK has no include mechanism, so the whole file is generated. This is also
# what nwg-look writes -- generating it keeps the settings in git and swapping
# with the palette, instead of living only in a GUI's memory.

[Settings]
gtk-theme-name=@GTK_THEME@
gtk-icon-theme-name=@ICON_THEME@
gtk-font-name=@FONT_UI@ @FONT_SIZE@
gtk-cursor-theme-name=@CURSOR_THEME@
gtk-cursor-theme-size=@CURSOR_SIZE@

# Older GTK3 apps that ship only a light/dark pair honour this rather than
# the theme name.
gtk-application-prefer-dark-theme=1

# Wayland draws its own decorations; a GTK titlebar on top would double up.
gtk-decoration-layout=:

# Subpixel rendering. The panel is standard RGB stripe.
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb

gtk-enable-animations=1
gtk-primary-button-warps-slider=0
