[General]
; KDE color scheme -- @NAME@
;
; GENERATED by `theme-set @NAME@` into
;   ~/.local/share/color-schemes/Rice.colors
; Do not edit; edit ~/dotfiles/theme-src/templates/kde-colors.colors.in
;
; ---------------------------------------------------------------------------
; WHY THIS FILE EXISTS
; ---------------------------------------------------------------------------
; Dolphin, Gwenview, Okular and the polkit agent all link KF6ColorScheme, and
; every KF6 app runs KColorSchemeManager at startup. That class OVERWRITES the
; application palette -- whatever qt6ct handed it -- with a .colors scheme:
;
;   kcolorschememanager.cpp (KF6 6.29), init():
;     scheme = KSharedConfig::openConfig() -> group "UiSettings" -> "ColorScheme"
;     if scheme.isEmpty(): schemePath = automaticColorSchemePath()
;     if !schemePath.isEmpty(): qApp->setPalette(
;             KColorScheme::createApplicationPalette(openConfig(schemePath)))
;
; With no `[UiSettings] ColorScheme` set, automaticColorSchemePath() picks
; Breeze or BreezeDark off Qt's colorScheme() style hint. Under
; QT_QPA_PLATFORMTHEME=qt6ct that hint reads LIGHT -- the XDG appearance
; portal says dark (`1`), but qt6ct does not forward it -- so KF6 apps loaded
; bundled light Breeze over the dark qt6ct palette and came out unreadable.
; Both Breeze schemes are compiled into kcolorscheme as Qt resources, so this
; happens with the `breeze` package NOT installed; /usr/share/color-schemes
; does not even exist here.
;
; Setting `[UiSettings] ColorScheme=Rice` in kdeglobals (theme-set does it via
; kwriteconfig6) points that same code path at this file instead. That is the
; supported route and it reaches everything the old QSS could not, including
; Dolphin's KItemListView file pane, which paints from a KColorScheme rather
; than from any styleable QWidget.
;
; ---------------------------------------------------------------------------
; WHY THE FILENAME IS FIXED
; ---------------------------------------------------------------------------
; KColorSchemeModel derives the scheme ID from the FILENAME (`Rice.colors` ->
; `Rice`) and only the display Name below from `[General] Name`. Keeping the
; filename constant across palettes means kdeglobals never has to be rewritten
; when the palette changes, and no stale `TokyoNight.colors` is left behind to
; show up in an app's Settings -> Color Scheme menu. Switching palette rewrites
; this file's contents; the ID it is referenced by never moves.
;
; ---------------------------------------------------------------------------
; FORMAT
; ---------------------------------------------------------------------------
; Values are decimal `R,G,B` -- KDE does NOT accept hex here, which is the trap
; that made this look like a dead end the first time round. Palettes still
; store bare hex; theme-set derives a decimal "_RGB" marker for every
; 6-hex-digit palette key, so this template stays on the same single source of
; truth as everything else. That suffix is reserved -- see theme-set.
;
; Keys verified against plasma/breeze colors/BreezeDark.colors (2026-08-19),
; not recalled. Every `Colors:*` group needs the full set of eleven keys; a
; missing one falls back to a Breeze default and reintroduces a light patch.
ColorScheme=Rice
Name=@NAME@
shadeSortColumn=true

[KDE]
contrast=4

; Applied to disabled widgets. ColorEffect=0 means `Color` is unused; the
; readable dimming comes from the contrast/intensity pair. Breeze's values,
; kept because they are tuned against a dark scheme already.
[ColorEffects:Disabled]
Color=@BG_HL_RGB@
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

; Enable=false: no extra washing-out of unfocused windows. This desktop already
; signals focus with a border color (conf/theme.lua), and dimming the whole
; window on top of that costs readability on the second monitor for nothing.
[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=@MUTED_RGB@
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

; Window chrome: toolbars, menu bars, dialog bodies.
[Colors:Window]
BackgroundNormal=@BG_DARK_RGB@
BackgroundAlternate=@BG_HL_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

; Content panes: Dolphin's file list, Okular's page area, every item view.
; One step lighter than Window so panes read as inset rather than flat.
[Colors:View]
BackgroundNormal=@BG_RGB@
BackgroundAlternate=@BG_HL_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

[Colors:Button]
BackgroundNormal=@BG_HL_RGB@
BackgroundAlternate=@SURFACE_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

; Selected rows. The background here is the light accent, so every foreground
; in this group has to be DARK to stay legible -- this is the one group where
; the usual light-on-dark mapping inverts. Negative keeps a distinct red
; because "this selected file failed" has to remain distinguishable.
[Colors:Selection]
BackgroundNormal=@ACCENT_RGB@
BackgroundAlternate=@SEL_BG_RGB@
ForegroundNormal=@BG_RGB@
ForegroundInactive=@SEL_BG_RGB@
ForegroundActive=@BG_RGB@
ForegroundLink=@SEL_BG_RGB@
ForegroundVisited=@SURFACE_RGB@
ForegroundNegative=@RED1_RGB@
ForegroundNeutral=@SEL_BG_RGB@
ForegroundPositive=@BG_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

[Colors:Tooltip]
BackgroundNormal=@BG_HL_RGB@
BackgroundAlternate=@SURFACE_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

; "Complementary" is what Kirigami uses for deliberately contrasting areas --
; sidebars and header banners in the QML parts of Okular and Gwenview. Pointed
; at the deepest surface so those read as recessed, matching how BG_DARKER is
; used for the bar and the lock screen elsewhere.
[Colors:Complementary]
BackgroundNormal=@BG_DARKER_RGB@
BackgroundAlternate=@BG_DARK_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

[Colors:Header]
BackgroundNormal=@BG_DARK_RGB@
BackgroundAlternate=@BG_RGB@
ForegroundNormal=@FG_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

[Colors:Header][Inactive]
BackgroundNormal=@BG_DARKER_RGB@
BackgroundAlternate=@BG_DARK_RGB@
ForegroundNormal=@FG_DIM_RGB@
ForegroundInactive=@MUTED_RGB@
ForegroundActive=@ACCENT_RGB@
ForegroundLink=@CYAN_RGB@
ForegroundVisited=@MAGENTA_RGB@
ForegroundNegative=@URGENT_RGB@
ForegroundNeutral=@WARNING_RGB@
ForegroundPositive=@GOOD_RGB@
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@

; Titlebar colors, read by KDE apps that draw their own decorations. Hyprland
; draws the borders here (conf/theme.lua), so this group is mostly inert --
; filled in for completeness so no group falls back to a Breeze default.
[WM]
activeBackground=@BG_DARK_RGB@
activeForeground=@FG_RGB@
activeBlend=@FG_RGB@
inactiveBackground=@BG_DARKER_RGB@
inactiveForeground=@MUTED_RGB@
inactiveBlend=@MUTED_RGB@
