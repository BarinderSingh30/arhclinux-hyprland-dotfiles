/* pavucontrol-qt -- vibrant, minimal.
 *
 * GENERATED by `theme-set`. Do not edit; edit this template instead.
 * Applied via qt6ct's Interface/stylesheets key (qt6ct.conf.in), which is
 * global to any Qt6 app using qt6ct as its platform theme -- currently
 * that's just this mixer, so a look distinct from the rest of the rice
 * (qt6ct-colors.conf.in's exact palette match) is low-risk for now. If a
 * second Qt6 app shows up and wants the plain palette match instead, this
 * needs to move to something app-scoped.
 *
 * Actual window transparency is a Hyprland opacity rule on the
 * pavucontrol-qt class (conf/rules.lua), not anything in here -- Qt widgets
 * apps don't request an alpha surface on their own, so `background:
 * transparent` in QSS alone would not punch a real hole. This stylesheet
 * only has to look good once the compositor blends the whole window.
 *
 * "Vibrant" mostly lives in the slider fill: Qt's QSS has no nth-child
 * selector for QTabBar::tab, so per-tab hues aren't reachable -- the
 * gradient is where the multi-hue variety actually shows up.
 */

* {
    outline: none;
}

QWidget {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #@FG_DIM@;
    padding: 8px 16px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #@FG@;
}

QTabBar::tab:selected {
    color: #@FG@;
    border-bottom: 2px solid #@CYAN@;
}

QGroupBox {
    border: none;
    margin-top: 6px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #@CYAN@, stop:0.5 #@BLUE@, stop:1 #@MAGENTA@);
}

QSlider::add-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #@FG@;
}

QSlider::handle:horizontal:hover {
    background: #@CYAN@;
}

QComboBox {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 4px 8px;
}

QComboBox:hover {
    border-color: #@CYAN@;
}

QComboBox QAbstractItemView {
    background: #@BG_DARK@;
    border: 1px solid rgba(255, 255, 255, 0.10);
    selection-background-color: #@CYAN@;
}

QToolButton, QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover, QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}

/* Mute toggles: checked == muted, so red reuses the same semantic as
   #custom-battery.critical / #network.disconnected in waybar-style.css.in. */
QToolButton:checked {
    background: #@RED@;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #@CYAN@;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    background: none;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
}

QCheckBox::indicator:checked {
    background: #@GREEN@;
    border-color: #@GREEN@;
}

QLabel {
    background: transparent;
}
