/* @NAME@ -- color variables only.
 *
 * GENERATED by `theme-set @NAME@` into ~/.config/theme/rofi.rasi
 * Do not edit; edit ~/dotfiles/theme-src/templates/rofi-colors.rasi.in
 *
 * ~/.config/rofi/config.rasi @imports this and then does all the layout in
 * terms of var(...). Colors and geometry stay in separate files so a palette
 * swap can never move a widget.
 *
 * rofi 2.0 resolves var() lazily, so declaring everything in one `*` block
 * is fine regardless of reference order.
 */

* {
    bg:            #@BG@;
    bg-alt:        #@BG_DARK@;
    bg-highlight:  #@BG_HL@;
    surface:       #@SURFACE@;

    fg:            #@FG@;
    fg-dim:        #@FG_DIM@;
    muted:         #@MUTED@;

    accent:        #@ACCENT@;
    accent-alt:    #@ACCENT_ALT@;
    urgent:        #@URGENT@;
    good:          #@GOOD@;

    /* The `highlight` property takes a style AND a color as one value, and
     * rofi forbids a var() standing for only part of a property -- see
     * `man 5 rofi-theme`, "It cannot be used for a subpart of the property".
     * So the whole value has to be the variable. */
    match-highlight: bold #@ACCENT_ALT@;

    /* rofi's own well-known names, so any unstyled widget inherits sanely
       instead of falling back to the built-in Solarized default. */
    background:                  var(bg);
    background-color:            transparent;
    foreground:                  var(fg);
    border-color:                var(accent);
    separatorcolor:              var(surface);

    normal-background:           transparent;
    normal-foreground:           var(fg);
    alternate-normal-background: transparent;
    alternate-normal-foreground: var(fg);
    selected-normal-background:  var(accent);
    selected-normal-foreground:  var(bg);

    active-background:           transparent;
    active-foreground:           var(accent-alt);
    alternate-active-background: transparent;
    alternate-active-foreground: var(accent-alt);
    selected-active-background:  var(accent-alt);
    selected-active-foreground:  var(bg);

    urgent-background:           transparent;
    urgent-foreground:           var(urgent);
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: var(urgent);
    selected-urgent-background:  var(urgent);
    selected-urgent-foreground:  var(bg);
}
