; Qt 6 palette -- @NAME@
;
; GENERATED by `theme-set @NAME@` into ~/.config/qt6ct/colors/theme.conf
; Do not edit; edit ~/dotfiles/theme-src/templates/qt6ct-colors.conf.in
;
; Format: a comma-separated list of #aarrggbb colors, one per QPalette color
; role, in QPalette::ColorRole enum order. qt6ct reads it as
;   for (i = 0; i < QPalette::NColorRoles; i++) role = ColorRole(i)
; so position IS the role -- the list is order-sensitive and must be complete.
;
; The enum was read from the installed header, not recalled:
;   /usr/include/qt6/QtGui/qpalette.h  (qt6-base 6.11.1)
;
;    0 WindowText   6 Text        12 Highlight        18 ToolTipBase
;    1 Button       7 BrightText  13 HighlightedText  19 ToolTipText
;    2 Light        8 ButtonText  14 Link             20 PlaceholderText
;    3 Midlight     9 Base        15 LinkVisited      21 Accent
;    4 Dark        10 Window      16 AlternateBase
;    5 Mid         11 Shadow      17 NoRole
;
; Qt 6.6 appended `Accent`, making NColorRoles 22. qt6ct requires
; count() >= NColorRoles or it silently discards the scheme -- which is why
; the 21-entry schemes shipped in /usr/share/qt6ct/colors are dead on this
; Qt version. This file has all 22.

[ColorScheme]
active_colors=#ff@FG@, #ff@BG_HL@, #ff@SURFACE@, #ff@BG_HL@, #ff@BG_DARKER@, #ff@BG_DARK@, #ff@FG@, #ff@URGENT@, #ff@FG@, #ff@BG@, #ff@BG_DARK@, #ff@BG_DARKER@, #ff@ACCENT@, #ff@BG@, #ff@CYAN@, #ff@MAGENTA@, #ff@BG_HL@, #ff@BG@, #ff@BG_HL@, #ff@FG@, #ff@MUTED@, #ff@ACCENT@
inactive_colors=#ff@FG_DIM@, #ff@BG_HL@, #ff@SURFACE@, #ff@BG_HL@, #ff@BG_DARKER@, #ff@BG_DARK@, #ff@FG_DIM@, #ff@URGENT@, #ff@FG_DIM@, #ff@BG@, #ff@BG_DARK@, #ff@BG_DARKER@, #ff@SURFACE@, #ff@FG@, #ff@CYAN@, #ff@MAGENTA@, #ff@BG_HL@, #ff@BG@, #ff@BG_HL@, #ff@FG@, #ff@MUTED@, #ff@ACCENT@
disabled_colors=#ff@MUTED@, #ff@BG_HL@, #ff@SURFACE@, #ff@BG_HL@, #ff@BG_DARKER@, #ff@BG_DARK@, #ff@MUTED@, #ff@MUTED@, #ff@MUTED@, #ff@BG_DARK@, #ff@BG_DARK@, #ff@BG_DARKER@, #ff@SURFACE@, #ff@MUTED@, #ff@MUTED@, #ff@MUTED@, #ff@BG_HL@, #ff@BG@, #ff@BG_HL@, #ff@MUTED@, #ff@MUTED@, #ff@SURFACE@
