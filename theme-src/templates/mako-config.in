# mako 1.11 -- @NAME@
#
# GENERATED by `theme-set @NAME@` into ~/.config/mako/config
# Do not edit; edit ~/dotfiles/theme-src/templates/mako-config.in
#
# mako does support `include=`, but its parser is section-scoped: any line
# after a `[criteria]` header belongs to that criteria. Splitting colors into
# an included file would make the whole config order-fragile for no real gain,
# since this file is only 40 lines. The template in git is the source of
# truth; behaviour and palette live together.
#
# This replaces dunst as the org.freedesktop.Notifications owner. It handles
# APPLICATION notifications only -- the fractional-scale overlay suppressed in
# conf/misc.lua is compositor-drawn and never touches this daemon.

# --- Placement ------------------------------------------------------------
# Empty output = follow the focused monitor, so notifications appear on the
# screen you are actually looking at rather than always on the laptop.
output=
anchor=top-right
layer=top
outer-margin=10
margin=0,0,8,0

# --- Geometry -------------------------------------------------------------
width=360
height=140
padding=12
border-size=2
border-radius=0
icons=1
max-icon-size=48
icon-location=left
icon-path=/usr/share/icons/@ICON_THEME@:/usr/share/icons/hicolor

# --- Text -----------------------------------------------------------------
font=@FONT_UI@ @FONT_SIZE@
markup=1
format=<b>%s</b>\n%b
text-alignment=left

# --- Behaviour ------------------------------------------------------------
default-timeout=5000
ignore-timeout=0
max-visible=4
max-history=20
sort=-time
group-by=app-name

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

# --- Colors ---------------------------------------------------------------
background-color=#@BG_DARK@f2
text-color=#@FG@
border-color=#@ACCENT@
progress-color=over #@ACCENT@66

# --- Per-urgency ----------------------------------------------------------
# Criteria are matched in file order and the LAST matching style option wins,
# so these must stay below the globals above.

[urgency=low]
border-color=#@SURFACE@
text-color=#@FG_DIM@
default-timeout=3000

[urgency=normal]
border-color=#@ACCENT@

[urgency=critical]
border-color=#@URGENT@
text-color=#@FG@
background-color=#@BG_DARK@f2
# Zero disables the timeout: something critical should not vanish unread.
default-timeout=0

# --- Do not disturb -------------------------------------------------------
# Toggle with:  makoctl mode -t do-not-disturb
# Notifications still land in history and can be replayed with
#   makoctl restore
[mode=do-not-disturb]
invisible=1
