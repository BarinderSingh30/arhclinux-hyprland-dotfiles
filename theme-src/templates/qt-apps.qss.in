/* Shared Qt6 widgets stylesheet -- vibrant, minimal.
 *
 * GENERATED by `theme-set`. Do not edit; edit this template instead.
 * Applied via qt6ct's Interface/stylesheets key (qt6ct.conf.in), which is
 * global to any Qt6 app using qt6ct as its platform theme -- currently
 * pavucontrol-qt and wifi-qt (wifi-qt-src/), both of which get this look
 * for free with no per-app theming work. A third Qt6 app that wanted the
 * plain palette match instead (qt6ct-colors.conf.in) would need this
 * split into something app-scoped.
 *
 * Actual window transparency is a Hyprland opacity rule per class
 * (conf/rules.lua: mixer-transparency, wifi-qt-transparency), not anything
 * in here -- Qt widgets apps don't request an alpha surface on their own,
 * so `background: transparent` in QSS alone would not punch a real hole.
 * This stylesheet only has to look good once the compositor blends the
 * whole window.
 *
 * "Vibrant" mostly lives in the slider fill and the list selection color:
 * Qt's QSS has no nth-child selector for QTabBar::tab, so per-tab hues
 * aren't reachable -- gradients and accent highlights are where the
 * multi-hue variety actually shows up instead.
 */

* {
    outline: none;
}

QWidget {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #@FG_DIM@;
    padding: 8px 16px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #@FG@;
}

QTabBar::tab:selected {
    color: #@FG@;
    border-bottom: 2px solid #@CYAN@;
}

QGroupBox {
    border: none;
    margin-top: 6px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #@CYAN@, stop:0.5 #@BLUE@, stop:1 #@MAGENTA@);
}

QSlider::add-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #@FG@;
}

QSlider::handle:horizontal:hover {
    background: #@CYAN@;
}

QComboBox {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 4px 8px;
}

QComboBox:hover {
    border-color: #@CYAN@;
}

QComboBox QAbstractItemView {
    background: #@BG_DARK@;
    border: 1px solid rgba(255, 255, 255, 0.10);
    selection-background-color: #@CYAN@;
}

QToolButton, QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover, QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}

/* Mute toggles: checked == muted, so red reuses the same semantic as
   #custom-battery.critical / #network.disconnected in waybar-style.css.in. */
QToolButton:checked {
    background: #@RED@;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #@CYAN@;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    background: none;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
}

QCheckBox::indicator:checked {
    background: #@GREEN@;
    border-color: #@GREEN@;
}

QLabel {
    background: transparent;
}

/* wifi-qt's network list -- pavucontrol-qt has no QListWidget, so this only
   applies there. */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.06);
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(125, 207, 255, 0.35), stop:1 rgba(187, 154, 247, 0.20));
    color: #@FG@;
}

QToolBar {
    background: transparent;
    border: none;
    spacing: 6px;
    padding: 6px;
}

QStatusBar {
    background: transparent;
}
