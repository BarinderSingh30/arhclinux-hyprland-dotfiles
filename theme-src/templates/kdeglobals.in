; kdeglobals -- @NAME@
;
; GENERATED by `theme-set @NAME@` into ~/.config/kdeglobals
; Do not edit; edit ~/dotfiles/theme-src/templates/kdeglobals.in
;
; What this fixes: qt6ct.conf's [Appearance] color_scheme_path only sets the
; QPalette (Fusion style). Dolphin's sidebar (Places panel) and other KDE
; Frameworks chrome -- kio, kiconthemes -- don't read QPalette for their
; background; they use KColorScheme, which is a SEPARATE color system keyed
; off ~/.config/kdeglobals. With no kdeglobals, KColorScheme falls back to
; its compiled-in default (light) colors, so the sidebar looks light while
; the rest of the qt6ct-themed window is dark -- a "mixed theme" that has
; nothing to do with qt6ct being misconfigured.
;
; Key names are literal strings pulled from the installed lib, not recalled:
;   strings /usr/lib/libKF6ColorScheme.so.6.28.0 | grep -i background
;   -> BackgroundNormal, BackgroundAlternate (only these two are stored per
;      set; Active/Link/Visited/Negative/Neutral/Positive backgrounds are
;      derived by shading BackgroundNormal when absent, not read from config)
;   strings ... | grep -iE 'foreground|active|link|visited|negative|...'
;   -> all 8 ForegroundRole names ARE stored: ForegroundNormal, -Inactive,
;      -Active, -Link, -Visited, -Negative, -Neutral, -Positive
; ColorSet group names (View/Window/Button/Selection/Tooltip/Complementary/
; Header) are from the public KColorScheme::ColorSet enum in
; /usr/include/KF6/KColorScheme/kcolorscheme.h.
;
; Dolphin's places sidebar and other non-editable chrome use the Window set;
; the file listing and other selectable content use View. Both are set to
; the same surfaces here since this palette doesn't distinguish them.

[Colors:View]
BackgroundNormal=@BG@
BackgroundAlternate=@BG_HL@
ForegroundNormal=@FG@
ForegroundInactive=@MUTED@
ForegroundActive=@ACCENT@
ForegroundLink=@CYAN@
ForegroundVisited=@MAGENTA@
ForegroundNegative=@URGENT@
DecorationFocus=@ACCENT@
DecorationHover=@ACCENT@

[Colors:Window]
BackgroundNormal=@BG@
BackgroundAlternate=@BG_HL@
ForegroundNormal=@FG@
ForegroundInactive=@MUTED@
ForegroundActive=@ACCENT@
ForegroundLink=@CYAN@
ForegroundVisited=@MAGENTA@
ForegroundNegative=@URGENT@
DecorationFocus=@ACCENT@
DecorationHover=@ACCENT@

[Colors:Button]
BackgroundNormal=@BG_HL@
BackgroundAlternate=@SURFACE@
ForegroundNormal=@FG@
ForegroundInactive=@MUTED@
DecorationFocus=@ACCENT@
DecorationHover=@ACCENT@

; HighlightedText is @BG@ in qt6ct-colors.conf.in for the same Highlight
; role -- mirrored here so selection contrast matches everywhere.
[Colors:Selection]
BackgroundNormal=@ACCENT@
BackgroundAlternate=@ACCENT@
ForegroundNormal=@BG@
ForegroundInactive=@BG_DARK@
DecorationFocus=@ACCENT@
DecorationHover=@ACCENT@

[Colors:Tooltip]
BackgroundNormal=@BG_DARK@
ForegroundNormal=@FG@

[Colors:Complementary]
BackgroundNormal=@BG_DARKER@
ForegroundNormal=@FG@

[Colors:Header]
BackgroundNormal=@BG_DARK@
ForegroundNormal=@FG_DIM@
