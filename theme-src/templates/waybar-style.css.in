/* waybar 0.15 -- @NAME@
 *
 * GENERATED by `theme-set @NAME@` into ~/.config/waybar/style.css
 * Do not edit; edit ~/dotfiles/theme-src/templates/waybar-style.css.in
 *
 * The WHOLE stylesheet is generated rather than a static file importing a
 * colors file. waybar's GTK CSS @import needs an absolute file:// URL, and
 * hardcoding /home/barinder into a version-controlled dotfile is worse than
 * generating 150 lines. Layout still lives in git -- it lives in this
 * template.
 *
 * GTK3 CSS, not web CSS: no `gap`, no custom properties, no `:has()`.
 * @define-color is GTK's own mechanism and is what makes the palette
 * readable at the top instead of smeared through every rule.
 */

@define-color bg          #@BG@;
@define-color bg-dark     #@BG_DARK@;
@define-color bg-darker   #@BG_DARKER@;
@define-color bg-hl       #@BG_HL@;
@define-color surface     #@SURFACE@;

@define-color fg          #@FG@;
@define-color fg-dim      #@FG_DIM@;
@define-color muted       #@MUTED@;

@define-color accent      #@ACCENT@;
@define-color accent-alt  #@ACCENT_ALT@;
@define-color urgent      #@URGENT@;
@define-color warning     #@WARNING@;
@define-color good        #@GOOD@;

/* Module accents.
 *
 * Deliberately separate from the semantic names above: `warning` has to keep
 * meaning "something needs attention", so a module that merely happens to be
 * yellow must not borrow it. Re-colour a module by changing the rule that
 * uses these, not by redefining what warning means.
 *
 * Assignment runs left-to-right along the bar so no two neighbours sit next
 * to each other on the colour wheel -- magenta, cyan, teal, orange, purple --
 * which is what stops it reading as a rainbow smear. Every value comes from
 * the palette, so a theme switch recolours the whole row coherently. */
@define-color cyan        #@CYAN@;
@define-color teal        #@TEAL@;
@define-color orange      #@ORANGE@;
@define-color magenta     #@MAGENTA@;
@define-color purple      #@PURPLE@;

/* -------------------------------------------------------------------------
 * Reset
 * ---------------------------------------------------------------------- */
* {
    /* Kill GTK's default 1px focus ring; the bar draws its own states. */
    border: none;
    border-radius: 0;
    min-height: 0;
    font-family: "@FONT_BAR@";
    font-size: @FONT_SIZE_BAR@px;
    /* Fixed-width digits: stops the clock and percentages from jittering as
       glyph widths change. */
    font-feature-settings: "tnum";
}

window#waybar {
    /* Transparency, set in the palette as BAR_OPACITY. alpha() is GTK's own
       CSS function (GTK3 here -- waybar 0.15 links libgtk-3), so the colour
       stays a single @define-color above and only its opacity is varied.
       Writing an rgba() literal instead would mean duplicating the hex. */
    background-color: alpha(@bg-dark, @BAR_OPACITY@);
    color: @fg;
    /* A hairline instead of a border: enough to separate the bar from a
       maximized window, invisible against the wallpaper. */
    box-shadow: inset 0 -1px @surface;
}

window#waybar.hidden {
    opacity: 0.0;
}

tooltip {
    background-color: @bg-dark;
    border: 1px solid @surface;
    color: @fg;
}

tooltip label {
    color: @fg;
    padding: 2px;
}

/* -------------------------------------------------------------------------
 * Workspaces
 *
 * Sharp underline for the active workspace rather than a filled pill --
 * matches rounding = 0 in the compositor.
 * ---------------------------------------------------------------------- */
#workspaces {
    margin: 0 4px;
}

/* Two states only: focused, and everything else.
 *
 * waybar exposes four separate classes here -- idle, .persistent (occupied),
 * .visible (showing on the other monitor) and .active/.focused -- and giving
 * each its own shade made the row read as a gradient of greys with no obvious
 * meaning. All the non-focused ones are deliberately collapsed into one
 * colour so the focused workspace is the only thing the eye has to find.
 *
 * To bring back the "occupied vs empty" distinction, give
 * `#workspaces button.persistent` its own colour below the base rule. */
#workspaces button {
    padding: 0 9px;
    margin: 0;
    color: @fg-dim;
    background-color: transparent;
    /* Reserve the underline on every button so text never shifts when the
       focused one gains it. */
    box-shadow: inset 0 -2px transparent;
    transition: color 120ms ease, box-shadow 120ms ease;
}

#workspaces button:hover {
    color: @fg;
    background-color: @bg-hl;
    box-shadow: inset 0 -2px @surface;
}

/* Still shouts, because "needs attention" has to outrank looking tidy. */
#workspaces button.urgent {
    color: @urgent;
    box-shadow: inset 0 -2px @urgent;
}

/* Focused, and LAST on purpose.
 *
 * GTK CSS resolves ties by source order, and .active/.visible/.urgent all
 * have identical specificity. The previous version had .visible written after
 * .active, so a workspace that was both focused and visible lost its accent
 * to the dimmer rule. Keeping this rule at the bottom means focus always
 * wins, whatever else the button happens to be. */
#workspaces button.active,
#workspaces button.focused {
    color: @accent;
    box-shadow: inset 0 -2px @accent;
}

#submap {
    color: @accent-alt;
    padding: 0 10px;
}

/* -------------------------------------------------------------------------
 * Clock
 * ---------------------------------------------------------------------- */
/* The clock is the one thing read constantly, so it gets the accent -- the
   same blue as the focused window border and the active workspace, which ties
   the bar to the rest of the desktop instead of adding a sixth hue. */
#clock {
    color: @accent;
    font-weight: bold;
    padding: 0 12px;
}

#clock:hover {
    color: @fg;
}

/* -------------------------------------------------------------------------
 * Right-hand modules
 * ---------------------------------------------------------------------- */
/* Shared geometry only. Colour is per-module below -- one flat grey for the
   whole row is what made the bar look monotonous. */
#tray,
#custom-tray-toggle,
#wireplumber,
#network,
#memory,
#cpu,
#custom-battery,
#custom-power {
    padding: 0 10px;
    background-color: transparent;
}

/* The chevron that opens the tray drawer. A UI control, not a data readout,
   so it follows #custom-power's treatment below rather than joining the
   coloured module row: quiet until you reach for it. */
#custom-tray-toggle {
    color: @fg-dim;
}

#custom-tray-toggle:hover {
    color: @accent;
    background-color: @bg-hl;
}

/* The row, in order. Colour carries the identity so the icons stay readable
   at a glance without labels; the background stays flat and transparent,
   because coloured pills behind every module is the thing that tips this from
   classy into busy. */
#wireplumber            { color: @magenta; }
#network                { color: @cyan;    }
#memory                 { color: @teal;    }
#cpu                    { color: @orange;  }

/* The power button sits quiet until you reach for it. Colouring it red
   permanently would put a standing alarm in the corner of a bar that is
   otherwise calm -- and red already means "urgent" everywhere else here. */
#custom-power {
    color: @fg-dim;
    padding-right: 12px;
}

#custom-power:hover {
    color: @urgent;
    background-color: @bg-hl;
}

/* Separator between the last module and the screen edge. */
.modules-right > widget:last-child > * {
    padding-right: 14px;
}

/* Hover lifts the background only. Setting `color: @fg` here as well would
   throw away the module colour at exactly the moment the pointer is on it.
   #custom-battery joined this group when it started reacting to clicks
   (power-profile-cycle) -- the native battery module never did, so it
   never needed the cue. */
#wireplumber:hover,
#network:hover,
#memory:hover,
#cpu:hover,
#custom-battery:hover {
    background-color: @bg-hl;
}

#wireplumber.muted {
    color: @muted;
}

#network.disconnected,
#network.disabled {
    color: @urgent;
}

#memory.warning,
#cpu.warning {
    color: @warning;
}

#memory.critical,
#cpu.critical {
    color: @urgent;
}

#custom-battery {
    color: @good;
}

#custom-battery.charging {
    color: @accent;
}

#custom-battery.warning:not(.charging) {
    color: @warning;
}

#custom-battery.critical:not(.charging) {
    color: @urgent;
    animation: blink 1s steps(2, start) infinite;
}

@keyframes blink {
    to { color: @fg; }
}

/* -------------------------------------------------------------------------
 * Tray
 * ---------------------------------------------------------------------- */
#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    color: @urgent;
}

#tray menu {
    background-color: @bg-dark;
    color: @fg;
    border: 1px solid @surface;
}

#tray menu menuitem:hover {
    background-color: @accent;
    color: @bg;
}
