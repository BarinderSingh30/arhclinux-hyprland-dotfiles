/* waybar 0.15 -- @NAME@
 *
 * GENERATED by `theme-set @NAME@` into ~/.config/waybar/style.css
 * Do not edit; edit ~/dotfiles/theme-src/templates/waybar-style.css.in
 *
 * The WHOLE stylesheet is generated rather than a static file importing a
 * colors file. waybar's GTK CSS @import needs an absolute file:// URL, and
 * hardcoding /home/barinder into a version-controlled dotfile is worse than
 * generating 150 lines. Layout still lives in git -- it lives in this
 * template.
 *
 * GTK3 CSS, not web CSS: no `gap`, no custom properties, no `:has()`.
 * @define-color is GTK's own mechanism and is what makes the palette
 * readable at the top instead of smeared through every rule.
 */

@define-color bg          #@BG@;
@define-color bg-dark     #@BG_DARK@;
@define-color bg-darker   #@BG_DARKER@;
@define-color bg-hl       #@BG_HL@;
@define-color surface     #@SURFACE@;

@define-color fg          #@FG@;
@define-color fg-dim      #@FG_DIM@;
@define-color muted       #@MUTED@;

@define-color accent      #@ACCENT@;
@define-color accent-alt  #@ACCENT_ALT@;
@define-color urgent      #@URGENT@;
@define-color warning     #@WARNING@;
@define-color good        #@GOOD@;

/* -------------------------------------------------------------------------
 * Reset
 * ---------------------------------------------------------------------- */
* {
    /* Kill GTK's default 1px focus ring; the bar draws its own states. */
    border: none;
    border-radius: 0;
    min-height: 0;
    font-family: "@FONT_BAR@";
    font-size: @FONT_SIZE_BAR@px;
    /* Fixed-width digits: stops the clock and percentages from jittering as
       glyph widths change. */
    font-feature-settings: "tnum";
}

window#waybar {
    background-color: @bg-dark;
    color: @fg;
    /* A hairline instead of a border: enough to separate the bar from a
       maximized window, invisible against the wallpaper. */
    box-shadow: inset 0 -1px @surface;
}

window#waybar.hidden {
    opacity: 0.0;
}

tooltip {
    background-color: @bg-dark;
    border: 1px solid @surface;
    color: @fg;
}

tooltip label {
    color: @fg;
    padding: 2px;
}

/* -------------------------------------------------------------------------
 * Workspaces
 *
 * Sharp underline for the active workspace rather than a filled pill --
 * matches rounding = 0 in the compositor.
 * ---------------------------------------------------------------------- */
#workspaces {
    margin: 0 4px;
}

#workspaces button {
    padding: 0 9px;
    margin: 0;
    color: @muted;
    background-color: transparent;
    /* Reserve the underline on every button so text never shifts when the
       active one gains it. */
    box-shadow: inset 0 -2px transparent;
    transition: color 120ms ease, box-shadow 120ms ease;
}

#workspaces button:hover {
    color: @fg-dim;
    background-color: @bg-hl;
    box-shadow: inset 0 -2px @surface;
}

/* Occupied but not focused. */
#workspaces button.persistent {
    color: @fg-dim;
}

/* Focused on this monitor. */
#workspaces button.active,
#workspaces button.focused {
    color: @accent;
    box-shadow: inset 0 -2px @accent;
}

/* Visible on the other monitor -- dimmer than focused, brighter than idle,
   which matters with a permanent second screen. */
#workspaces button.visible {
    color: @fg;
    box-shadow: inset 0 -2px @surface;
}

#workspaces button.urgent {
    color: @urgent;
    box-shadow: inset 0 -2px @urgent;
}

#submap {
    color: @accent-alt;
    padding: 0 10px;
}

/* -------------------------------------------------------------------------
 * Clock
 * ---------------------------------------------------------------------- */
#clock {
    color: @fg;
    font-weight: bold;
    padding: 0 12px;
}

#clock:hover {
    color: @accent;
}

/* -------------------------------------------------------------------------
 * Right-hand modules
 * ---------------------------------------------------------------------- */
#tray,
#wireplumber,
#backlight,
#network,
#memory,
#cpu,
#battery {
    padding: 0 10px;
    color: @fg-dim;
    background-color: transparent;
}

/* Separator between the last module and the screen edge. */
.modules-right > widget:last-child > * {
    padding-right: 14px;
}

#wireplumber:hover,
#backlight:hover,
#network:hover,
#memory:hover,
#cpu:hover {
    color: @fg;
    background-color: @bg-hl;
}

#wireplumber.muted {
    color: @muted;
}

#network.disconnected,
#network.disabled {
    color: @urgent;
}

#memory.warning,
#cpu.warning {
    color: @warning;
}

#memory.critical,
#cpu.critical {
    color: @urgent;
}

#battery {
    color: @good;
}

#battery.charging {
    color: @accent;
}

#battery.warning:not(.charging) {
    color: @warning;
}

#battery.critical:not(.charging) {
    color: @urgent;
    animation: blink 1s steps(2, start) infinite;
}

@keyframes blink {
    to { color: @fg; }
}

/* -------------------------------------------------------------------------
 * Tray
 * ---------------------------------------------------------------------- */
#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    color: @urgent;
}

#tray menu {
    background-color: @bg-dark;
    color: @fg;
    border: 1px solid @surface;
}

#tray menu menuitem:hover {
    background-color: @accent;
    color: @bg;
}
