# GTK 4 -- @NAME@
#
# GENERATED by `theme-set @NAME@` into ~/.config/gtk-4.0/settings.ini
# Do not edit; edit ~/dotfiles/theme-src/templates/gtk4-settings.ini.in
#
# libadwaita apps ignore gtk-theme-name by design -- they follow the system
# color-scheme preference instead, which theme-set sets via gsettings. The
# keys below still apply to plain (non-libadwaita) GTK4 apps, and the font
# and cursor settings apply to both.

[Settings]
gtk-theme-name=@GTK_THEME@
gtk-icon-theme-name=@ICON_THEME@
gtk-font-name=@FONT_UI@ @FONT_SIZE@
gtk-cursor-theme-name=@CURSOR_THEME@
gtk-cursor-theme-size=@CURSOR_SIZE@
gtk-application-prefer-dark-theme=1
gtk-decoration-layout=:

gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb

gtk-enable-animations=1
