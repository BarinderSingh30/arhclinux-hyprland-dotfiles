# hyprlock -- generated by theme-set. Do not edit; edit this template instead.
#   template: theme-src/templates/hyprlock.conf.in
#   output:   ~/.config/hypr/hyprlock.conf
#
# Option names and defaults were read from upstream hyprlock v0.9.6
# src/config/ConfigManager.cpp -- NOT from memory.
#
# The general{} block accepts exactly these keys: text_trim, hide_cursor,
# ignore_empty_input, immediate_render, fractional_scaling, screencopy_mode,
# fail_timeout.
#
# Note `grace` and `no_fade_in`, which older guides put inside general{}, are
# CLI flags in this version (`hyprlock --grace 5`, `--no-fade-in`) and are not
# registered as config values. Putting them in this file does nothing.
#
# `--grace N` is worth knowing for testing: it gives N seconds during which
# any input dismisses the lock without a password. That makes it safe to
# launch the lock screen to check it renders without risking being stuck.
#
# Colors are hyprlang rgba() taking bare hex + alpha, so the palette's
# "#"-less values drop straight in.

$font_mono = @FONT_MONO@
$font_ui   = @FONT_UI@

general {
    hide_cursor        = true

    # Enter on an empty field does nothing rather than counting as a failed
    # attempt -- otherwise a stray keypress starts the fail timeout.
    ignore_empty_input = true

    # Draw the first frame as soon as possible. Without this there is a brief
    # window where the unblurred desktop is still visible after locking.
    immediate_render   = true

    fail_timeout       = 2000
}

auth {
    pam {
        enabled = true
        module  = hyprlock
    }
}

animations {
    enabled  = true
    bezier   = linear, 1, 1, 0, 0
    animation = fadeIn,          1, 4, linear
    animation = fadeOut,         1, 4, linear
    animation = inputFieldDots,  1, 2, linear
}

# ---------------------------------------------------------------------------
# Background -- the live desktop, blurred.
#
# path = screenshot grabs the real screen contents at lock time. Empty
# monitor = applies this to every output, so both eDP-1 and HDMI-A-1 get it.
# color is the fallback if the screencopy grab fails; keeping it the darkest
# surface in the palette means a failure looks deliberate, not broken.
# ---------------------------------------------------------------------------
background {
    monitor           =
    path              = screenshot
    color             = rgba(@BG_DARKER@ff)

    blur_passes       = 3
    blur_size         = 8

    # Pushed darker than upstream defaults so white text stays readable over
    # a bright wallpaper or a light document that happened to be on screen.
    brightness        = 0.55
    contrast          = 0.90
    vibrancy          = 0.17
    vibrancy_darkness = 0.15
    noise             = 0.0117
}

# ---------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------
label {
    monitor     =
    text        = $TIME
    color       = rgba(@FG@ff)
    font_size   = 96
    font_family = $font_mono

    position    = 0, 190
    halign      = center
    valign      = center
}

label {
    monitor     =
    text        = cmd[update:60000] date +"%A, %d %B"
    color       = rgba(@MUTED@ff)
    font_size   = 18
    font_family = $font_ui

    position    = 0, 110
    halign      = center
    valign      = center
}

# ---------------------------------------------------------------------------
# Password field -- sharp corners, matching `rounding = 0` in the compositor.
# ---------------------------------------------------------------------------
input-field {
    monitor           =
    size              = 320, 52
    rounding          = 0
    outline_thickness = 2

    inner_color       = rgba(@BG_DARK@e6)
    outer_color       = rgba(@ACCENT@ff)
    font_color        = rgba(@FG@ff)

    check_color       = rgba(@INFO@ff)
    fail_color        = rgba(@URGENT@ff)

    # Caps Lock is the single most common reason a correct password "fails",
    # so the outline turns warning-colored instead of leaving you guessing.
    capslock_color    = rgba(@WARNING@ff)

    font_family       = $font_ui
    # Plain pango italics, no color span: hyprlang treats "#" as a comment
    # and its escape form is not documented in anything shipped on disk, so
    # a hex color here would be a guess. font_color covers it.
    placeholder_text  = <i>Password</i>
    fail_text         = <i>$FAIL</i>

    # Keep the field visible when empty; fading it out just hides where to type.
    fade_on_empty     = false
    dots_size         = 0.28
    dots_spacing      = 0.3
    dots_center       = true

    position          = 0, 0
    halign            = center
    valign            = center
}

# ---------------------------------------------------------------------------
# Who is logged in. Useful precisely because autologin means you may not
# remember which account the machine came up as.
# ---------------------------------------------------------------------------
label {
    monitor     =
    text        = $USER
    color       = rgba(@DIM3@ff)
    font_size   = 14
    font_family = $font_ui

    position    = 0, -60
    halign      = center
    valign      = center
}
