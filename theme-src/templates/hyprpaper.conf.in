# hyprpaper 0.8.4 -- @NAME@
#
# GENERATED by `theme-set @NAME@` into ~/.config/hypr/hyprpaper.conf
# Do not edit; edit ~/dotfiles/theme-src/templates/hyprpaper.conf.in
#
# Generated only because hyprpaper does not expand '~' in `path` -- the
# absolute prefix has to be substituted in.
#
# NOTE ON SYNTAX: hyprpaper 0.8 dropped `preload =` and the
# `wallpaper = <monitor>,<path>` one-liner. Wallpapers are now special
# categories keyed on `monitor`. Verified against upstream
# src/config/ConfigManager.cpp (addSpecialCategory("wallpaper", {.key =
# "monitor"})), not from memory -- every guide still showing `preload` is
# writing for 0.7 and earlier.
#
# The image is downscaled to 1920x1080 by theme-set before it lands here:
# hyprpaper decodes to an uncompressed surface, so the 3800x2149 original
# would cost ~32 MB of RAM per output for detail neither panel can resolve.

# No splash text over the wallpaper.
splash = false

# Leave IPC on so a wallpaper can be swapped without a restart later.
ipc = true

# fit_mode: contain | cover | tile | fit.
# cover fills the output and crops the overflow -- correct here because the
# two screens have different aspect ratios (16:9 and 16:10) and `contain`
# would letterbox the external one.

wallpaper {
    monitor  = eDP-1
    path     = @THEME_DIR@/wallpaper.jpg
    fit_mode = cover
}

wallpaper {
    monitor  = HDMI-A-1
    path     = @THEME_DIR@/wallpaper.jpg
    fit_mode = cover
}
