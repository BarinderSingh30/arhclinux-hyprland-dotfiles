-- conf/theme.lua -- @NAME@
--
-- GENERATED by `theme-set @NAME@`. Do not edit; edit the template instead:
--   ~/dotfiles/theme-src/templates/hypr-theme.lua.in
-- Colors come from ~/dotfiles/theme-src/palettes/@NAME@.env
--
-- Unlike every other generated file, this one is written back INTO the
-- dotfiles repo rather than into ~/.config/theme/. That is deliberate: a bare
-- clone + stow must produce a working compositor without having run theme-set
-- first. A broken hyprland.lua means no desktop, so it gets the safe design.

local M = {}

M.name = "@NAME@"
M.mode = "@MODE@"

-- Surfaces
M.bg            = "@BG@"
M.bg_dark       = "@BG_DARK@"
M.bg_darker     = "@BG_DARKER@"
M.bg_highlight  = "@BG_HL@"
M.surface       = "@SURFACE@"

-- Text
M.fg            = "@FG@"
M.fg_dim        = "@FG_DIM@"
M.muted         = "@MUTED@"

-- Hues
M.red           = "@RED@"
M.orange        = "@ORANGE@"
M.yellow        = "@YELLOW@"
M.green         = "@GREEN@"
M.teal          = "@TEAL@"
M.cyan          = "@CYAN@"
M.blue          = "@BLUE@"
M.purple        = "@PURPLE@"
M.magenta       = "@MAGENTA@"

-- Semantic roles -- modules reference these, not the raw hues above, so a
-- palette with different accent choices still slots in cleanly.
M.accent        = "@ACCENT@"      -- focused border, active workspace
M.accent_alt    = "@ACCENT_ALT@"  -- border gradient partner
M.inactive      = "@INACTIVE@"    -- unfocused window border
M.urgent        = "@URGENT@"
M.warning       = "@WARNING@"
M.good          = "@GOOD@"

--- Build an rgba() string Hyprland accepts, from a hex triplet + alpha byte.
--- @param hex string   six-digit hex, no leading '#'
--- @param alpha string two-digit hex alpha (default "ff")
--- @return string
function M.rgba(hex, alpha)
    return "rgba(" .. hex .. (alpha or "ff") .. ")"
end

--- Same but opaque rgb().
--- @param hex string
--- @return string
function M.rgb(hex)
    return "rgb(" .. hex .. ")"
end

return M
