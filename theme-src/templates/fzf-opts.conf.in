# fzf default options -- generated by theme-set. Do not edit; edit the
# template instead.
#   template: theme-src/templates/fzf-opts.conf.in
#   output:   ~/.config/theme/fzf.conf
#
# fzf reads this because conf/40-tools.zsh exports FZF_DEFAULT_OPTS_FILE
# pointing at it. That variable is fzf's own "read defaults from a file"
# mechanism (verified in `fzf --help` on 0.74.2), which is why this lands in
# ~/.config/theme/ with the other include-style outputs rather than being
# generated over some app's whole config.
#
# Format is one command-line option per line. Comments and blank lines are
# fine. fzf validates colour names strictly -- an unknown one aborts with
# "invalid color specification" and exit 2, so a typo here fails loudly at
# first use rather than being ignored.

--height=40%
--layout=reverse
--border=sharp
--info=inline
--cycle
--pointer=▌
--marker=▏

# rounding = 0 everywhere in this rice, hence border=sharp.
# --height keeps fzf below the cursor instead of taking the whole terminal, so
# you can still see the command you were typing and the output above it.

# ---------------------------------------------------------------------------
# Colours. Element names verified by round-tripping this exact spec through
# `fzf --filter`, which parses --color and rejects unknown names.
#
# bg:-1 and gutter:-1 mean "the terminal's own background" -- fzf's way of
# staying transparent. That matters because kitty's background already comes
# from this same palette, so hardcoding it here would only create a second
# place for it to drift.
# ---------------------------------------------------------------------------
--color=fg:#@FG_DIM@,bg:-1,hl:#@ACCENT@
--color=fg+:#@FG@,bg+:#@BG_HL@,hl+:#@INFO@
--color=info:#@MUTED@,prompt:#@ACCENT_ALT@,pointer:#@URGENT@
--color=marker:#@GOOD@,spinner:#@WARNING@,header:#@MUTED@
--color=border:#@SURFACE@,separator:#@SURFACE@,scrollbar:#@SURFACE@
--color=gutter:-1,query:#@FG@,disabled:#@DIM3@
--color=preview-fg:#@FG@,preview-bg:#@BG_DARK@
