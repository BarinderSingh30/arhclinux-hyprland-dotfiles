# starship -- generated by theme-set. Do not edit; edit this template instead.
#   template: theme-src/templates/starship.toml.in
#   output:   ~/.config/starship.toml
#
# Verified against starship 1.26.0, not recalled: the custom-palette mechanism
# is `[palettes.<name>]` plus a top-level `palette = '<name>'`, and starship
# has no include directive -- so the whole file is generated, the same way
# waybar's CSS and mako's config are.
#
# Validate a change with `starship print-config`, which prints the computed
# config and errors on anything it could not parse. `starship timings` shows
# per-module cost if the prompt ever feels slow.
#
# Colors need a leading '#'; palette values are stored bare, so it is added
# here.

"$schema" = 'https://starship.rs/config-schema.json'

# ---------------------------------------------------------------------------
# Layout -- two lines.
#
# Line 1 is context: where you are, what git thinks, what the last command
# did. Line 2 is just the prompt character, so the place you type is always
# at the same column no matter how long the path is. That is the whole reason
# for two lines -- a single-line prompt pushes your cursor further right the
# deeper you cd.
#
# The trailing '\' joins these onto one line; it is TOML's line-continuation
# inside a multi-line string, not part of the output.
# ---------------------------------------------------------------------------
format = """
$directory\
$git_branch\
$git_status\
$cmd_duration\
$status\
$line_break\
$character"""

# Blank line before each prompt. Costs a row, but it visually separates one
# command's output from the next, which matters a lot when scrolling back.
add_newline = true

# Give up on a slow module rather than stall the prompt. Relevant on a
# spinning-up filesystem or a huge repo.
scan_timeout = 30
command_timeout = 500

palette = 'theme'

# ---------------------------------------------------------------------------
[directory]
# truncate_to_repo: inside a git repo, show the path from the repo root rather
# than from ~. So you see `dotfiles/theme-src` instead of a long absolute path.
style = "bold fg:accent"
truncation_length = 3
truncate_to_repo = true
truncation_symbol = "…/"
format = "[$path]($style)[$read_only]($read_only_style) "
read_only = " 󰌾"
read_only_style = "fg:warning"

# ---------------------------------------------------------------------------
[git_branch]
#  is U+E0A0, the powerline branch glyph -- present in JetBrainsMono Nerd
# Font, which is this machine's terminal font.
symbol = " "
style = "fg:accent_alt"
format = "[$symbol$branch]($style) "

[git_status]
# Compact symbols: ! modified, + staged, ? untracked, ✘ deleted, » renamed,
# $ stashed, ⇡/⇣ ahead/behind the remote.
style = "fg:warning"
format = "([$all_status$ahead_behind]($style)) "
conflicted = "="
untracked = "?${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"
stashed = "\\$${count}"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇡${ahead_count}⇣${behind_count}"

# ---------------------------------------------------------------------------
[cmd_duration]
# Only speaks up when something actually took a while, so it is silent for
# every normal command.
min_time = 2000
style = "fg:muted"
format = "[took $duration]($style) "

# ---------------------------------------------------------------------------
[status]
# Off by default in starship. Turned on because a failed command otherwise
# leaves no trace once its output scrolls past -- and the exit code is the
# first thing worth knowing when something did not work.
disabled = false
style = "fg:urgent"
symbol = "✘ "
format = "[$symbol$status]($style) "
map_symbol = false

# ---------------------------------------------------------------------------
[character]
# Green ❯ means the last command succeeded, red means it failed. This is the
# fastest possible signal and it costs no horizontal space.
success_symbol = "[❯](bold fg:good)"
error_symbol = "[❯](bold fg:urgent)"
vimcmd_symbol = "[❮](bold fg:accent)"

# ---------------------------------------------------------------------------
# Palette
#
# Names here are ROLES, not hues -- the same discipline the rest of the theme
# system uses. A palette whose accent is green slots in without editing any
# module above.
# ---------------------------------------------------------------------------
[palettes.theme]
accent     = '#@ACCENT@'
accent_alt = '#@ACCENT_ALT@'
fg         = '#@FG@'
muted      = '#@MUTED@'
good       = '#@GOOD@'
warning    = '#@WARNING@'
urgent     = '#@URGENT@'
info       = '#@INFO@'
