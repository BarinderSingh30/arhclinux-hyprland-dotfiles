# @NAME@ -- colors only.
#
# GENERATED by `theme-set @NAME@` into ~/.config/theme/kitty.conf
# Do not edit; edit ~/dotfiles/theme-src/templates/kitty-theme.conf.in
#
# ~/.config/kitty/kitty.conf pulls this in with `include`, so every
# non-color kitty setting stays hand-written and version-controlled while
# the palette swaps underneath it.

background              #@BG@

# Transparency. Set in the palette as TERM_OPACITY.
#
# kitty applies this at STARTUP. Per its own docs, changing it by reloading the
# config "will only work if dynamic_background_opacity was enabled in the
# original config" -- and that option is off by default because it carries a
# rendering cost, which is not worth paying permanently on an Iris Plus G1 for
# a value that changes about twice a year. So after `theme-set`, already-open
# terminals keep the old opacity; a newly opened one is correct immediately.
#
# Deliberately NOT set: background_blur. Blurring what shows through is a
# per-frame GPU cost, and this config turns blur off everywhere else for the
# same reason (see conf/decorations.lua).
background_opacity      @TERM_OPACITY@
foreground              #@FG@
selection_background    #@SEL_BG@
selection_foreground    #@FG@
url_color               #@GREEN1@
cursor                  #@CURSOR@
cursor_text_color       #@BG@

# Tabs
active_tab_background   #@ACCENT@
active_tab_foreground   #@BG_DARK@
inactive_tab_background #@BG_HL@
inactive_tab_foreground #@DIM3@
tab_bar_background      #@T0@

# Splits
active_border_color     #@ACCENT@
inactive_border_color   #@BG_HL@

# Marks / bells
mark1_background        #@ACCENT@
mark1_foreground        #@BG@

# normal
color0  #@T0@
color1  #@T1@
color2  #@T2@
color3  #@T3@
color4  #@T4@
color5  #@T5@
color6  #@T6@
color7  #@T7@

# bright
color8  #@T8@
color9  #@T9@
color10 #@T10@
color11 #@T11@
color12 #@T12@
color13 #@T13@
color14 #@T14@
color15 #@T15@

# extended
color16 #@ORANGE@
color17 #@RED1@
