# Gruvbox Dark (medium contrast)
#
# Verified 2026-08-17 against upstream, not from memory:
#   https://github.com/morhetz/gruvbox  colors/gruvbox.vim
#
# This palette exists as the ACCEPTANCE TEST for the theme system: it proves
# a second palette can drop into the same key contract and move waybar,
# rofi, kitty, mako, Dolphin, GTK and the window borders together with one
# command. Delete it freely if you never want to see it.
#
#   theme-set gruvbox      # switch
#   theme-set tokyonight   # switch back
#
# See tokyonight.env for the key contract. Same keys, different values.

NAME=gruvbox
MODE=dark

# --- Surfaces -------------------------------------------------------------
BG=282828            # dark0
BG_DARK=1d2021       # dark0_hard
BG_DARKER=141617     # darker than upstream defines; for the lock screen
BG_HL=3c3836         # dark1
SURFACE=504945       # dark2

# --- Text -----------------------------------------------------------------
FG=ebdbb2            # light1
FG_DIM=d5c4a1        # light2
MUTED=928374         # gray_245
DIM3=a89984          # light4

# --- Hues -----------------------------------------------------------------
RED=fb4934
ORANGE=fe8019
YELLOW=fabd2f
GREEN=b8bb26
TEAL=689d6a
GREEN1=8ec07c        # bright_aqua -- fills the same role as tokyonight's
CYAN=8ec07c
BLUE=83a598
PURPLE=b16286
MAGENTA=d3869b
RED1=cc241d

# --- Semantic roles -------------------------------------------------------
# Note the accent is warm here where Tokyo Night is cool. Nothing outside
# this block needs to know that -- which is the whole point.
ACCENT=fabd2f        # yellow
ACCENT_ALT=fe8019    # orange
INACTIVE=504945
URGENT=fb4934
WARNING=fabd2f
GOOD=b8bb26
INFO=8ec07c

# --- Terminal 16 ----------------------------------------------------------
T0=282828
T1=cc241d
T2=98971a
T3=d79921
T4=458588
T5=b16286
T6=689d6a
T7=a89984
T8=928374
T9=fb4934
T10=b8bb26
T11=fabd2f
T12=83a598
T13=d3869b
T14=8ec07c
T15=ebdbb2

# --- Terminal extras ------------------------------------------------------
SEL_BG=504945
CURSOR=ebdbb2

# --- Wallpaper ------------------------------------------------------------
# Same image; it is dark and warm enough to sit under either palette.
WALLPAPER=~/Pictures/wallpapers/dzukill_wallpaper.jpg

# --- Toolkit themes -------------------------------------------------------
GTK_THEME=adw-gtk3-dark
ICON_THEME=Papirus-Dark
CURSOR_THEME=Adwaita
CURSOR_SIZE=24
COLOR_SCHEME=prefer-dark

# --- Fonts ----------------------------------------------------------------
FONT_UI=Noto Sans
FONT_MONO=JetBrainsMono Nerd Font
FONT_BAR=JetBrainsMono Nerd Font
FONT_SIZE=11
FONT_SIZE_BAR=13

# --- bat syntax theme -----------------------------------------------------
# Exact match: bat ships a real gruvbox theme, so this one needs no
# approximating. See tokyonight.env for why this is a name and not colors.
BAT_THEME=gruvbox-dark

# --- Transparency ---------------------------------------------------------
# Used by kitty (background_opacity) and waybar (GTK alpha() on the bar).
# 1.0 = fully opaque, 0.0 = invisible. The bar sits lower than the terminal
# because it is a thin strip over the wallpaper, where more show-through reads
# as intentional; a terminal full of text needs the contrast.
#
# Changing these takes effect on `theme-set`, but note kitty applies
# background_opacity at STARTUP: already-open windows keep the old value until
# they are reopened. See the note in templates/kitty-theme.conf.in.
TERM_OPACITY=0.92
BAR_OPACITY=0.85
