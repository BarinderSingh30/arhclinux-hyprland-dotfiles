# Tokyo Night -- "Night" variant
#
# Verified 2026-08-17 against upstream, not from memory:
#   https://github.com/folke/tokyonight.nvim
#     lua/tokyonight/colors/storm.lua  (base)
#     lua/tokyonight/colors/night.lua  (bg overrides)
#     extras/kitty/tokyonight_night.conf  (terminal 16)
#
# ---------------------------------------------------------------------------
# CONTRACT
# ---------------------------------------------------------------------------
# Hex values are BARE -- six digits, no leading '#'. Templates add '#' or
# 'rgba()' as their format needs. Storing them bare is what lets one value
# serve CSS, rasi, Lua and INI without per-format duplicates.
#
# Every palette MUST define every key in this file. theme-set refuses to
# install output that still contains an unsubstituted @KEY@ marker, so a
# palette missing a key fails loudly instead of shipping a broken config.
#
# To add a palette: copy this file, change the values, keep the keys.
# ---------------------------------------------------------------------------

NAME=tokyonight
MODE=dark

# --- Surfaces -------------------------------------------------------------
BG=1a1b26            # main background
BG_DARK=16161e       # recessed: bar, popups, unfocused surfaces
BG_DARKER=0c0e14     # deepest: lock screen, gaps
BG_HL=292e42         # hovered / highlighted row
SURFACE=3b4261       # separators, inactive borders, scrollbar trough

# --- Text -----------------------------------------------------------------
FG=c0caf5            # primary text
FG_DIM=a9b1d6        # secondary text
MUTED=565f89         # comments, disabled, placeholder
DIM3=545c7e          # inactive tab text

# --- Hues -----------------------------------------------------------------
RED=f7768e
ORANGE=ff9e64
YELLOW=e0af68
GREEN=9ece6a
TEAL=1abc9c
GREEN1=73daca        # upstream "green1" -- the cyan-green used for URLs
CYAN=7dcfff
BLUE=7aa2f7
PURPLE=9d7cd8
MAGENTA=bb9af7
RED1=db4b4b          # deeper red, for critical states

# --- Semantic roles -------------------------------------------------------
# Modules reference THESE, never the raw hues above. A palette whose accent
# is green instead of blue then slots in without touching a single template.
ACCENT=7aa2f7        # focused border, active workspace, selection
ACCENT_ALT=bb9af7    # border-gradient partner, secondary highlight
INACTIVE=3b4261      # unfocused window border
URGENT=f7768e
WARNING=e0af68
GOOD=9ece6a
INFO=7dcfff

# --- Terminal 16 ----------------------------------------------------------
T0=15161e
T1=f7768e
T2=9ece6a
T3=e0af68
T4=7aa2f7
T5=bb9af7
T6=7dcfff
T7=a9b1d6
T8=414868
T9=ff899d
T10=9fe044
T11=faba4a
T12=8db0ff
T13=c7a9ff
T14=a4daff
T15=c0caf5

# --- Terminal extras ------------------------------------------------------
SEL_BG=283457        # selection background
CURSOR=c0caf5

# --- Wallpaper ------------------------------------------------------------
# Paired with the palette on purpose: a light palette would want a light
# image, so switching theme should switch wallpaper too.
#
# theme-set does NOT hand this file to hyprpaper directly. It downscales it
# once to ~/.config/theme/wallpaper.jpg at panel resolution, because
# hyprpaper decodes to an uncompressed surface -- the 3800x2149 source would
# sit in RAM as ~32 MB per output, and RAM is the tight resource here.
#
# The image itself is not in the repo; only this path is.
WALLPAPER=~/Pictures/wallpapers/dzukill_wallpaper.jpg

# --- Toolkit themes -------------------------------------------------------
# Not colors, but palette-scoped: a light palette needs the light variants.
GTK_THEME=adw-gtk3-dark
ICON_THEME=Papirus-Dark
CURSOR_THEME=Adwaita
CURSOR_SIZE=24
COLOR_SCHEME=prefer-dark

# --- Fonts ----------------------------------------------------------------
# All three verified installed -- `fc-match` resolves each to itself, not a
# substitute, so nothing here renders as tofu.
#
# FONT_UI is proportional on purpose: a monospace face in GTK/Qt menus reads
# as a mistake. FONT_BAR stays monospace because waybar needs Nerd Font
# glyphs and because fixed-width digits stop the clock from jittering.
FONT_UI=Noto Sans
FONT_MONO=JetBrainsMono Nerd Font
FONT_BAR=JetBrainsMono Nerd Font
FONT_SIZE=11
FONT_SIZE_BAR=13

# --- bat syntax theme -----------------------------------------------------
# Must be a name from `bat --list-themes`. bat themes are .tmTheme XML, not
# something generatable from these keys, so a palette picks the closest
# built-in instead. Catppuccin Mocha is the nearest match here: same dark
# blue-violet base and desaturated pastel accents as Tokyo Night.
BAT_THEME=Catppuccin Mocha
