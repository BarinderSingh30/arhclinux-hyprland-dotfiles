// waybar 0.15 -- layout and behaviour. Colors live in style.css, which is
// GENERATED by `theme-set` from theme-src/templates/waybar-style.css.in.
//
// Two bar objects, one per output. They are separate rather than one shared
// bar because the two screens genuinely need different things: eDP-1 has a
// battery and a backlight, HDMI-A-1 has neither, and only one bar may own the
// system tray (two StatusNotifierHosts fight over the same items).
//
// Workspaces 1-5 are bound to HDMI-A-1 and 6-10 to eDP-1 in
// conf/workspaces.lua, and "all-outputs": false makes each bar show only the
// set that belongs to its own screen.
[
    // =====================================================================
    // eDP-1 -- laptop panel, 1920x1080 @ 1.25x. Carries the tray and the
    // laptop-only hardware modules.
    // =====================================================================
    {
        "name": "laptop",
        "output": "eDP-1",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 0,
        "exclusive": true,
        "fixed-center": true,
        // Re-read the stylesheet when theme-set rewrites it, so a palette
        // switch lands without restarting the bar.
        "reload_style_on_change": true,

        "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
        "modules-center": ["clock"],
        "modules-right":  ["tray", "wireplumber", "backlight", "network",
                           "memory", "cpu", "battery"],

        "hyprland/workspaces": {
            "format": "{id}",
            "all-outputs": false,
            "persistent-only": true,
            "show-special": false,
            "sort-by": "number",
            "on-click": "activate"
        },

        "hyprland/submap": {
            "format": "{}",
            "tooltip": false
        },

        "clock": {
            "interval": 30,
            "format": "{:%H:%M}",
            "format-alt": "{:%a %d %b  %H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "mode": "month",
                "weeks-pos": "right",
                "format": {
                    "months":  "<span color='#c0caf5'><b>{}</b></span>",
                    "days":    "<span color='#a9b1d6'>{}</span>",
                    "weeks":   "<span color='#7dcfff'>W{}</span>",
                    "weekdays":"<span color='#e0af68'><b>{}</b></span>",
                    "today":   "<span color='#7aa2f7'><b><u>{}</u></b></span>"
                }
            }
        },

        "tray": {
            "icon-size": 16,
            "spacing": 10,
            "show-passive-items": false
        },

        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟",
            "format-icons": ["󰕿", "󰖀", "󰕾"],
            "scroll-step": 5,
            "max-volume": 100,
            // wpctl is already what the XF86Audio keys use in conf/binds.lua;
            // pavucontrol is not installed and is not worth 40 MB of GTK.
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
            "tooltip-format": "{node_name}"
        },

        "backlight": {
            "device": "intel_backlight",
            "interval": 2,
            "format": "{icon} {percent}%",
            "format-icons": ["󰃞", "󰃟", "󰃠"],
            "scroll-step": 5,
            "tooltip": false
        },

        "network": {
            "interval": 5,
            "format-wifi": "󰖩 {signalStrength}%",
            "format-ethernet": "󰈀",
            "format-linked": "󰈀 no IP",
            "format-disconnected": "󰖪",
            "tooltip-format-wifi": "{essid}  {ipaddr}/{cidr}\n{bandwidthDownBits} / {bandwidthUpBits}",
            "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
            "tooltip-format-disconnected": "offline",
            // nmtui ships with networkmanager, so this needs nothing extra.
            // conf/rules.lua floats and centers the class.
            "on-click": "kitty --class nmtui -e nmtui"
        },

        "memory": {
            "interval": 5,
            // Absolute GiB, not a percentage: 7.4 GB total is the binding
            // constraint on this machine and "62%" does not tell you whether
            // another browser window will fit.
            "format": "󰍛 {used:0.1f}G",
            "states": { "warning": 75, "critical": 90 },
            "tooltip-format": "{used:0.1f}G of {total:0.1f}G used\nswap {swapUsed:0.1f}G of {swapTotal:0.1f}G",
            "on-click": "kitty --class btop -e btop"
        },

        "cpu": {
            "interval": 5,
            "format": "󰻠 {usage}%",
            "states": { "warning": 70, "critical": 90 },
            "tooltip": false,
            "on-click": "kitty --class btop -e btop"
        },

        "battery": {
            "interval": 30,
            "states": { "warning": 30, "critical": 15 },
            "format": "{icon} {capacity}%",
            "format-charging": "󰂄 {capacity}%",
            // Empty format hides the module. The machine lives on AC, so a
            // permanent "100% plugged" badge would be pure noise -- this way
            // the battery only appears when it has something to say.
            "format-plugged": "",
            "format-full": "",
            "format-icons": ["󰁺", "󰁽", "󰁿", "󰂁", "󰂂"],
            "tooltip-format": "{capacity}%  {timeTo}"
        }
    },

    // =====================================================================
    // HDMI-A-1 -- external 1440x900 @ 1x. No tray, no battery, no backlight:
    // the tray belongs to exactly one bar, and the other two describe
    // hardware this screen does not have.
    // =====================================================================
    {
        "name": "external",
        "output": "HDMI-A-1",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 0,
        "exclusive": true,
        "fixed-center": true,
        "reload_style_on_change": true,

        "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
        "modules-center": ["clock"],
        "modules-right":  ["wireplumber", "network", "memory"],

        "hyprland/workspaces": {
            "format": "{id}",
            "all-outputs": false,
            "persistent-only": true,
            "show-special": false,
            "sort-by": "number",
            "on-click": "activate"
        },

        "hyprland/submap": {
            "format": "{}",
            "tooltip": false
        },

        "clock": {
            "interval": 30,
            "format": "{:%H:%M}",
            "format-alt": "{:%a %d %b  %H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>"
        },

        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟",
            "format-icons": ["󰕿", "󰖀", "󰕾"],
            "scroll-step": 5,
            "max-volume": 100,
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "tooltip-format": "{node_name}"
        },

        "network": {
            "interval": 5,
            "format-wifi": "󰖩 {signalStrength}%",
            "format-ethernet": "󰈀",
            "format-linked": "󰈀 no IP",
            "format-disconnected": "󰖪",
            "tooltip-format-wifi": "{essid}  {ipaddr}/{cidr}",
            "tooltip-format-disconnected": "offline",
            "on-click": "kitty --class nmtui -e nmtui"
        },

        "memory": {
            "interval": 5,
            "format": "󰍛 {used:0.1f}G",
            "states": { "warning": 75, "critical": 90 },
            "tooltip-format": "{used:0.1f}G of {total:0.1f}G used",
            "on-click": "kitty --class btop -e btop"
        }
    }
]
