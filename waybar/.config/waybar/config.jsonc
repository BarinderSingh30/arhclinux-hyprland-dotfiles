// waybar 0.15 -- layout and behaviour. Colors live in style.css, which is
// GENERATED by `theme-set` from theme-src/templates/waybar-style.css.in.
//
// Two bar objects, one per output. They are separate rather than one shared
// bar because the two screens genuinely need different things: eDP-1 has the
// battery and the power profile, HDMI-A-1 has neither, and only one bar may
// own the system tray (two StatusNotifierHosts fight over the same items).
//
// No brightness module: the backlight is driven by the XF86MonBrightness keys
// (see conf/binds.lua), which is how it actually gets adjusted, so a readout
// of it was just occupying space.
//
// Workspaces 1-5 are bound to HDMI-A-1 and 6-10 to eDP-1 in
// conf/workspaces.lua, and "all-outputs": false makes each bar show only the
// set that belongs to its own screen.
[
    // =====================================================================
    // eDP-1 -- laptop panel, 1920x1080 @ 1.25x. Carries the tray and the
    // laptop-only hardware modules.
    // =====================================================================
    {
        "name": "laptop",
        "output": "eDP-1",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 0,
        "exclusive": true,
        "fixed-center": true,
        // Re-read the stylesheet when theme-set rewrites it, so a palette
        // switch lands without restarting the bar.
        "reload_style_on_change": true,

        "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
        "modules-center": ["clock"],
        "modules-right":  ["group/tray-expander", "wireplumber", "network",
                           "memory", "cpu", "custom/notification", "custom/battery", "custom/power"],

        "hyprland/workspaces": {
            "format": "{id}",
            "all-outputs": false,
            "persistent-only": true,
            "show-special": false,
            "sort-by": "number",
            "on-click": "activate"
        },

        "hyprland/submap": {
            "format": "{}",
            "tooltip": false
        },

        "clock": {
            "interval": 30,
            "format": "{:%H:%M}",
            "format-alt": "{:%a %d %b  %H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "mode": "month",
                "weeks-pos": "right",
                "format": {
                    "months":  "<span color='#c0caf5'><b>{}</b></span>",
                    "days":    "<span color='#a9b1d6'>{}</span>",
                    "weeks":   "<span color='#7dcfff'>W{}</span>",
                    "weekdays":"<span color='#e0af68'><b>{}</b></span>",
                    "today":   "<span color='#7aa2f7'><b><u>{}</u></b></span>"
                }
            }
        },

        // The tray sits behind a chevron rather than showing directly:
        // today it's just blueman's icon, but the next app that wants a
        // tray icon (Spotify, Discord, Steam, ...) would otherwise crowd the
        // bar by default. Group drawers are waybar's native mechanism for
        // this -- there is no floating popup panel in waybar's tray/group
        // system, only an inline reveal that slides the hidden modules out
        // sideways next to the group leader, which is what this is.
        "custom/tray-toggle": {
            "format": "󰅂",
            "tooltip": true,
            "tooltip-format": "Tray"
        },

        "group/tray-expander": {
            "orientation": "inherit",
            "drawer": {
                "transition-duration": 300,
                "click-to-reveal": true
            },
            "modules": [
                "custom/tray-toggle", // group leader, never hidden
                "tray"
            ]
        },

        "tray": {
            "icon-size": 16,
            "spacing": 10,
            "show-passive-items": false
        },

        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟",
            "format-icons": ["󰕿", "󰖀", "󰕾"],
            "scroll-step": 5,
            "max-volume": 100,
            // pavucontrol-qt for the full per-app mixer -- qt6-base/qt6ct
            // were already installed for the rest of the theming pipeline,
            // so this was ~1MB. scripts/.local/bin/mixer-toggle opens it, or
            // closes it if it's already open, so the click behaves like a
            // toggle instead of stacking a new window each time -- $HOME
            // because waybar's spawn shell doesn't inherit ~/.local/bin on
            // PATH. Mute-toggle moved off left-click to make room for that;
            // scroll (above) still does volume steps as before.
            "on-click": "$HOME/.local/bin/mixer-toggle",
            "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
            "tooltip-format": "{node_name}"
        },

        "network": {
            "interval": 5,
            "format-wifi": "󰖩 {signalStrength}%",
            "format-ethernet": "󰈀",
            "format-linked": "󰈀 no IP",
            "format-disconnected": "󰖪",
            // Missing before: rfkill-off (nmcli radio wifi off, e.g. from
            // wifi-qt's own toggle) hits this state specifically, not
            // format-disconnected, and with nothing set for it waybar
            // rendered the module as empty text -- the icon just vanished
            // instead of showing "off".
            "format-disabled": "󰤭",
            "tooltip-format-disabled": "wifi disabled",
            "tooltip-format-wifi": "{essid}  {ipaddr}/{cidr}\n{bandwidthDownBits} / {bandwidthUpBits}",
            "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
            "tooltip-format-disconnected": "offline",
            // wifi-qt (wifi-qt-src/, built via `make -C ~/dotfiles/wifi-qt-src
            // install`) rather than the old rofi picker: scan, connect,
            // forget, radio toggle, in a real floating Qt window that
            // inherits the same vibrant qt6ct stylesheet as pavucontrol-qt
            // (theme-src/templates/qt-apps.qss.in). wifi-qt-toggle opens it
            // or closes it if already open, same as mixer-toggle for the
            // volume mixer. $HOME because waybar's spawn shell doesn't
            // inherit ~/.local/bin on PATH.
            "on-click": "$HOME/.local/bin/wifi-qt-toggle"
        },

        "memory": {
            "interval": 5,
            // Absolute GiB, not a percentage: 7.4 GB total is the binding
            // constraint on this machine and "62%" does not tell you whether
            // another browser window will fit.
            "format": "󰍛 {used:0.1f}G",
            "states": { "warning": 75, "critical": 90 },
            "tooltip-format": "{used:0.1f}G of {total:0.1f}G used\nswap {swapUsed:0.1f}G of {swapTotal:0.1f}G",
            "on-click": "kitty --class btop -e btop"
        },

        "cpu": {
            "interval": 5,
            "format": "󰻠 {usage}%",
            "states": { "warning": 70, "critical": 90 },
            "tooltip": false,
            "on-click": "kitty --class btop -e btop"
        },

        // swaync's own official waybar recipe: exec-if guards against this
        // erroring out if swaync were ever uninstalled, {0} in the format is
        // the unread count, and the format-icons cover every combination of
        // DND and inhibited state, not just plain has-notifications/none.
        "custom/notification": {
            "tooltip": true,
            "format": "{0} {icon}",
            "format-icons": {
                "notification": "󱅫",
                "none": "󰂜",
                "dnd-notification": "󰂠",
                "dnd-none": "󰪓",
                "inhibited-notification": "󰂛",
                "inhibited-none": "󰪑",
                "dnd-inhibited-notification": "󰂛",
                "dnd-inhibited-none": "󰪑"
            },
            "return-type": "json",
            "exec-if": "which swaync-client",
            "exec": "swaync-client -swb",
            "on-click": "swaync-client -t -sw",
            "on-click-right": "swaync-client -d -sw",
            "escape": true
        },

        // A custom module, not waybar's native battery module: the native
        // module's tooltip-format can't reach data from another daemon, and
        // the whole point here is showing the current power-profiles-daemon
        // profile in the tooltip (see scripts/.local/bin/battery-status for
        // why, and for where the icons/warning-critical thresholds that used
        // to live in this config moved to). Style is in
        // theme-src/templates/waybar-style.css.in under #custom-battery.
        //
        // on-click cycles performance -> balanced -> power-saver. That used
        // to be its own module/icon with native click-cycling; that icon was
        // dropped to keep the bar shorter and the click folded into battery
        // instead, since profile choice is really a power/battery concern.
        "custom/battery": {
            "exec": "$HOME/.local/bin/battery-status",
            "return-type": "json",
            "interval": 30,
            "on-click": "$HOME/.local/bin/power-profile-cycle"
        },

        // Opens the rofi power menu. Absolute-ish path via $HOME because
        // waybar runs this through a shell but does NOT inherit ~/.local/bin
        // on PATH -- Hyprland spawns waybar without a login shell.
        "custom/power": {
            "format": "󰐥",
            "tooltip": true,
            "tooltip-format": "Power",
            "on-click": "$HOME/.local/bin/power-menu"
        }
    },

    // =====================================================================
    // HDMI-A-1 -- external 1440x900 @ 1x. No tray, no battery, no backlight:
    // the tray belongs to exactly one bar, and the other two describe
    // hardware this screen does not have.
    // =====================================================================
    {
        "name": "external",
        "output": "HDMI-A-1",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 0,
        "exclusive": true,
        "fixed-center": true,
        "reload_style_on_change": true,

        "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
        "modules-center": ["clock"],
        // No battery or power-profiles here: this screen has neither, and a
        // second copy of a system-wide profile toggle invites clicking the
        // one you are not looking at. The power button IS duplicated, because
        // needing it while the pointer is on this screen is normal.
        "modules-right":  ["wireplumber", "network", "memory", "custom/notification", "custom/power"],

        "hyprland/workspaces": {
            "format": "{id}",
            "all-outputs": false,
            "persistent-only": true,
            "show-special": false,
            "sort-by": "number",
            "on-click": "activate"
        },

        "hyprland/submap": {
            "format": "{}",
            "tooltip": false
        },

        "clock": {
            "interval": 30,
            "format": "{:%H:%M}",
            "format-alt": "{:%a %d %b  %H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>"
        },

        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟",
            "format-icons": ["󰕿", "󰖀", "󰕾"],
            "scroll-step": 5,
            "max-volume": 100,
            "on-click": "$HOME/.local/bin/mixer-toggle",
            "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "tooltip-format": "{node_name}"
        },

        "network": {
            "interval": 5,
            "format-wifi": "󰖩 {signalStrength}%",
            "format-ethernet": "󰈀",
            "format-linked": "󰈀 no IP",
            "format-disconnected": "󰖪",
            // Missing before: rfkill-off (nmcli radio wifi off, e.g. from
            // wifi-qt's own toggle) hits this state specifically, not
            // format-disconnected, and with nothing set for it waybar
            // rendered the module as empty text -- the icon just vanished
            // instead of showing "off".
            "format-disabled": "󰤭",
            "tooltip-format-disabled": "wifi disabled",
            "tooltip-format-wifi": "{essid}  {ipaddr}/{cidr}",
            "tooltip-format-disconnected": "offline",
            "on-click": "$HOME/.local/bin/wifi-qt-toggle"
        },

        "memory": {
            "interval": 5,
            "format": "󰍛 {used:0.1f}G",
            "states": { "warning": 75, "critical": 90 },
            "tooltip-format": "{used:0.1f}G of {total:0.1f}G used",
            "on-click": "kitty --class btop -e btop"
        },

        // Repeated verbatim from the laptop bar. Module definitions are
        // resolved per bar object, so naming a module in modules-right above
        // is not enough on its own -- without this block the module
        // silently does not appear.
        "custom/notification": {
            "tooltip": true,
            "format": "{0} {icon}",
            "format-icons": {
                "notification": "󱅫",
                "none": "󰂜",
                "dnd-notification": "󰂠",
                "dnd-none": "󰪓",
                "inhibited-notification": "󰂛",
                "inhibited-none": "󰪑",
                "dnd-inhibited-notification": "󰂛",
                "dnd-inhibited-none": "󰪑"
            },
            "return-type": "json",
            "exec-if": "which swaync-client",
            "exec": "swaync-client -swb",
            "on-click": "swaync-client -t -sw",
            "on-click-right": "swaync-client -d -sw",
            "escape": true
        },

        "custom/power": {
            "format": "󰐥",
            "tooltip": true,
            "tooltip-format": "Power",
            "on-click": "$HOME/.local/bin/power-menu"
        }
    }
]
